desc:Masking Analyzer 5-Band (A vs B, gmem export)
options:gmem=mask_unmask

in_pin:Track B L
in_pin:Track B R
in_pin:Track A L
in_pin:Track A R

slider1:0.1<0.01,1,0.01>Smoothing (0=fast,1=slow)

@init
srate_inv = 1/srate;
smooth = slider1;

// helper
function hp_coeff(fc) (
  w = 2*$pi*fc*srate_inv;
  exp(-w);
);

function lp_coeff(fc) (
  w = 2*$pi*fc*srate_inv;
  1-exp(-w);
);

// band edges
hp_200   = hp_coeff(200);
lp_200   = lp_coeff(200);

hp_500   = hp_coeff(500);
lp_500   = lp_coeff(500);

hp_1200  = hp_coeff(1200);
lp_1200  = lp_coeff(1200);

hp_4000  = hp_coeff(4000);
lp_4000  = lp_coeff(4000);

hp_5000  = hp_coeff(5000);
lp_5000  = lp_coeff(5000);

@slider
smooth = slider1;

@sample
// Track B (to be unmasked)
b = 0.5*(spl0 + spl1);
// Track A (dominant)
a = 0.5*(spl2 + spl3);

// ---------------------------
// BAND 1: <150–200 Hz
// ---------------------------
b_b1 += lp_200 * (b - b_b1);
a_b1 += lp_200 * (a - a_b1);

// ---------------------------
// BAND 2: 200–500 Hz
// ---------------------------
b_b2_hp += hp_200 * (b - b_b2_hp);
a_b2_hp += hp_200 * (a - a_b2_hp);

b_b2 += lp_500 * (b_b2_hp - b_b2);
a_b2 += lp_500 * (a_b2_hp - a_b2);

// ---------------------------
// BAND 3: 500–1200 Hz
// ---------------------------
b_b3_hp += hp_500 * (b - b_b3_hp);
a_b3_hp += hp_500 * (a - a_b3_hp);

b_b3 += lp_1200 * (b_b3_hp - b_b3);
a_b3 += lp_1200 * (a_b3_hp - a_b3);

// ---------------------------
// BAND 4: 1200–4000 Hz
// ---------------------------
b_b4_hp += hp_1200 * (b - b_b4_hp);
a_b4_hp += hp_1200 * (a - a_b4_hp);

b_b4 += lp_4000 * (b_b4_hp - b_b4);
a_b4 += lp_4000 * (a_b4_hp - a_b4);

// ---------------------------
// BAND 5: >5000 Hz
// ---------------------------
b_b5 += hp_5000 * (b - b_b5);
a_b5 += hp_5000 * (a - a_b5);

// energies
e1 = b_b1*b_b1 - a_b1*a_b1;
e2 = b_b2*b_b2 - a_b2*a_b2;
e3 = b_b3*b_b3 - a_b3*a_b3;
e4 = b_b4*b_b4 - a_b4*a_b4;
e5 = b_b5*b_b5 - a_b5*a_b5;

// smooth
mask1 = mask1*smooth + e1*(1-smooth);
mask2 = mask2*smooth + e2*(1-smooth);
mask3 = mask3*smooth + e3*(1-smooth);
mask4 = mask4*smooth + e4*(1-smooth);
mask5 = mask5*smooth + e5*(1-smooth);

// write 5 bands
gmem[0] = mask1;
gmem[1] = mask2;
gmem[2] = mask3;
gmem[3] = mask4;
gmem[4] = mask5;

@gfx 400 200
gfx_clear = 0;
gfx_set(1,1,1,1);
gfx_x = 10; gfx_y = 10;
gfx_drawstr("Masking Analyzer 5-Band\nA=3/4, B=1/2");

bands = 5;
i = 0;
loop(bands,
  val = gmem[i];
  x = 20 + i*70;
  h = val*5000;
  h > 100 ? h = 100;
  h < -100 ? h = -100;

  val > 0 ? gfx_set(1,0,0,1) : gfx_set(0,0,1,1);
  gfx_rect(x, 150-h, 40, h);

  i += 1;
);
