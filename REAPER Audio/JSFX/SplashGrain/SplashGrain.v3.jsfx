desc: SplashGrain v3 – real-time granular splash for short audio clips

slider1:8<2,30,1>Grain Size (ms)
slider2:50<0,100,1>Pitch Chaos (%)
slider3:50<0,100,1>Mix (%)
slider4:1<0,1,1>Envelope Mode (0=manual, 1=audio envelope)

@init
grainpos = 0;
grainlen = 0;

@slider
grainlen = slider1 * srate * 0.001;
pitch_rng = slider2 / 100;
mix = slider3 / 100;
env_mode = slider4;

@sample
in = spl0;

// envelope follower
env = env_mode ? abs(in) : 1;

// increment grain position
grainpos += 1;
grainpos >= grainlen ? (
    grainpos = 0;

    // random pitch offset
    pitch = (rand(2)-1) * pitch_rng;

    // compute fractional read position
    readpos = grainpos * (1 + pitch);
    readpos < 0 ? readpos = 0;
    readpos >= grainlen ? readpos = grainlen - 1;

    // simple window (triangle)
    win = 1 - (grainpos / grainlen);

    // grain = current audio * window
    grain = in * win;
);

// output
out = in*(1-mix) + grain*(mix*env);

spl0 = out;
spl1 = out;
