desc:Karplus-Strong String Synth
// Simple Karplus–Strong physical modeling synth for REAPER (JSFX)
// Author: Copilot & Adam

in_pin:none
out_pin:mono
out_pin:stereo

slider1:60<24,96,1>Note (MIDI-style)
slider2:0.8<0.5,0.999,0.001>Damping
slider3:0.5<0,1,0.01>Excitation noise mix
slider4:0.3<0,1,0.01>Lowpass amount
slider5:0<0,1,0.01>Stereo spread
slider6:0<0,1,1>Retrigger (bang)

@init
freq = 440;
bufsize = 0;
bufpos = 0;
two_pi = 2*$pi;
sample_rate = srate;

// simple one-pole lowpass state
lp_stateL = 0;
lp_stateR = 0;

// function: set frequency from MIDI note
function set_note(n) (
  freq = 440 * 2^((n-69)/12);
  // buffer length ~ period
  bufsize = max(8, floor(sample_rate/freq));
  bufpos = 0;
);

// initialize
set_note(slider1);

// fill buffer with noise
function excite_buffer() (
  i = 0;
  loop(bufsize,
    // white noise -1..1
    noise = (rand(2)-1);
    // mix with previous content (for softer pluck)
    buf[i] = noise*slider3 + buf[i]*(1-slider3);
    i += 1;
  );
);

// trigger at start
excite_buffer();

@slider
// update note/frequency if slider changed
set_note(slider1);

// damping factor (feedback gain)
damp = slider2;

// lowpass coefficient
lp_a = slider4;

// stereo spread
spread = slider5;

// retrigger
slider6 > 0 ? (
  excite_buffer();
  slider6 = 0;
);

@sample
// Karplus–Strong core:
// y[n] = damp * 0.5 * (buf[pos] + buf[pos+1])
// with simple lowpass in the feedback

bufpos >= bufsize-1 ? bufpos = 0;

nextpos = bufpos+1;
nextpos >= bufsize ? nextpos = 0;

samp = 0.5 * (buf[bufpos] + buf[nextpos]);
samp *= damp;

// lowpass in feedback path
lp_stateL = lp_stateL + lp_a * (samp - lp_stateL);
lp_stateR = lp_stateR + lp_a * (samp - lp_stateR);

// write back into buffer
buf[bufpos] = lp_stateL;
bufpos += 1;

// stereo out with spread
spl0 = lp_stateL;
spl1 = lp_stateL*(1-spread) + lp_stateR*spread;
