desc:Masking Shaper Control Panel (5-Band)
options:gmem=mask_gui

// Band 1
slider1:0<0,10000,1>Band 1 Sensitivity
slider2:0<0,10,0.01>Band 1 Strength
slider3:1<0.1,4,0.01>Band 1 Exponent
slider4:0<0,1,0.01>Band 1 Knee
slider5:1<0,1,0.01>Band 1 Maxcut
slider6:0<0,500,1>Band 1 Attack (ms)
slider7:0<0,1000,1>Band 1 Release (ms)

// Band 2
slider8:0<0,10000,1>Band 2 Sensitivity
slider9:0<0,10,0.01>Band 2 Strength
slider10:1<0.1,4,0.01>Band 2 Exponent
slider11:0<0,1,0.01>Band 2 Knee
slider12:1<0,1,0.01>Band 2 Maxcut
slider13:0<0,500,1>Band 2 Attack (ms)
slider14:0<0,1000,1>Band 2 Release (ms)

// Band 3
slider15:0<0,10000,1>Band 3 Sensitivity
slider16:0<0,10,0.01>Band 3 Strength
slider17:1<0.1,4,0.01>Band 3 Exponent
slider18:0<0,1,0.01>Band 3 Knee
slider19:1<0,1,0.01>Band 3 Maxcut
slider20:0<0,500,1>Band 3 Attack (ms)
slider21:0<0,1000,1>Band 3 Release (ms)

// Band 4
slider22:0<0,10000,1>Band 4 Sensitivity
slider23:0<0,10,0.01>Band 4 Strength
slider24:1<0.1,4,0.01>Band 4 Exponent
slider25:0<0,1,0.01>Band 4 Knee
slider26:1<0,1,0.01>Band 4 Maxcut
slider27:0<0,500,1>Band 4 Attack (ms)
slider28:0<0,1000,1>Band 4 Release (ms)

// Band 5
slider29:0<0,10000,1>Band 5 Sensitivity
slider30:0<0,10,0.01>Band 5 Strength
slider31:1<0.1,4,0.01>Band 5 Exponent
slider32:0<0,1,0.01>Band 5 Knee
slider33:1<0,1,0.01>Band 5 Maxcut
slider34:0<0,500,1>Band 5 Attack (ms)
slider35:0<0,1000,1>Band 5 Release (ms)

@init
// nothing, GUI only

@slider
// write 35 values into gmem: 5 bands × 7 params
// layout per band: sens, strength, exp, knee, maxcut, attack, release

i = 0;

// Band 1
gmem[i] = slider1;  i += 1;
gmem[i] = slider2;  i += 1;
gmem[i] = slider3;  i += 1;
gmem[i] = slider4;  i += 1;
gmem[i] = slider5;  i += 1;
gmem[i] = slider6;  i += 1;
gmem[i] = slider7;  i += 1;

// Band 2
gmem[i] = slider8;  i += 1;
gmem[i] = slider9;  i += 1;
gmem[i] = slider10; i += 1;
gmem[i] = slider11; i += 1;
gmem[i] = slider12; i += 1;
gmem[i] = slider13; i += 1;
gmem[i] = slider14; i += 1;

// Band 3
gmem[i] = slider15; i += 1;
gmem[i] = slider16; i += 1;
gmem[i] = slider17; i += 1;
gmem[i] = slider18; i += 1;
gmem[i] = slider19; i += 1;
gmem[i] = slider20; i += 1;
gmem[i] = slider21; i += 1;

// Band 4
gmem[i] = slider22; i += 1;
gmem[i] = slider23; i += 1;
gmem[i] = slider24; i += 1;
gmem[i] = slider25; i += 1;
gmem[i] = slider26; i += 1;
gmem[i] = slider27; i += 1;
gmem[i] = slider28; i += 1;

// Band 5
gmem[i] = slider29; i += 1;
gmem[i] = slider30; i += 1;
gmem[i] = slider31; i += 1;
gmem[i] = slider32; i += 1;
gmem[i] = slider33; i += 1;
gmem[i] = slider34; i += 1;
gmem[i] = slider35; i += 1;

@sample
// no audio processing
